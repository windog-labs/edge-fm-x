{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edge-fm.local/schemas/vlaforge-trace-0.2.json",
  "title": "VLAForge Invocation Trace",
  "type": "object",
  "required": [
    "schema",
    "events"
  ],
  "properties": {
    "schema": {
      "const": "vlaforge.trace/0.2"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "index",
          "kind",
          "invocation",
          "run",
          "op",
          "data"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "kind": {
            "type": "string"
          },
          "invocation": {
            "type": "string"
          },
          "run": {
            "type": "integer",
            "minimum": 0
          },
          "op": {
            "type": "string"
          },
          "data": {}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
