# Copy to an untracked file, replace every absolute path, then export it:
#   set -a
#   source /path/to/autovla.env
#   set +a

VLAFORGE_AUTOVLA_SOURCE_ROOT=/absolute/path/to/AutoVLA
VLAFORGE_AUTOVLA_CHECKPOINT=/absolute/path/to/AutoVLA_PDMS_89.ckpt
VLAFORGE_AUTOVLA_CODEBOOK=/absolute/path/to/AutoVLA/codebook_cache/agent_vocab.pkl
VLAFORGE_AUTOVLA_QWEN_CONFIG=/absolute/path/to/AutoVLA/config/eval/qwen2.5-vl-3B-nusc-sft-eval.yaml
VLAFORGE_AUTOVLA_QWEN_MODEL_ROOT=/absolute/path/to/Qwen2.5-VL-3B-Instruct
VLAFORGE_HIGH_MEMORY_OUTPUT_ROOT=/absolute/path/to/results/autovla-high-memory
