#include "session_generated.h"
#include <cuda_runtime_api.h>
#include <chrono>
#include <cmath>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <fstream>
#include <string>
#include <vector>

namespace {
struct InputSpec {
  const char* name;
  VLAForgeDType dtype;
  std::vector<std::int64_t> shape;
  std::size_t bytes;
};
const std::vector<InputSpec> specs = {@INPUTS@};
constexpr std::size_t kOutputCount = @OUTPUT_COUNT@u;
struct Buffer {
  void* data = nullptr;
  ~Buffer() { if (data) (void)cudaFree(data); }
};
bool Cuda(cudaError_t error) {
  if (error == cudaSuccess) return true;
  std::fprintf(stderr, "CUDA failure: %s\n", cudaGetErrorString(error));
  return false;
}
bool Upload(const std::string& root, std::size_t input, Buffer& buffer) {
  const auto& spec = specs[input];
  const auto path = root + "/" + spec.name + ".bin";
  std::ifstream stream(path, std::ios::binary);
  std::vector<char> bytes(spec.bytes);
  stream.read(bytes.data(), static_cast<std::streamsize>(bytes.size()));
  if (stream.gcount() != static_cast<std::streamsize>(bytes.size()) ||
      stream.peek() != std::ifstream::traits_type::eof()) return false;
  return Cuda(cudaMemcpy(buffer.data, bytes.data(), bytes.size(), cudaMemcpyHostToDevice));
}
}

int main(int argc, char** argv) {
  if (argc != 5 && argc != 6) return 2;
  const bool input_series = argc == 6 && std::strcmp(argv[5], "series") == 0;
  if (argc == 6 && !input_series) return 2;
  char* end = nullptr;
  const auto repetitions = std::strtoull(argv[4], &end, 10);
  if (!end || *end || repetitions < 1u || repetitions > 10000u || !Cuda(cudaSetDevice(0))) return 3;
  std::vector<Buffer> buffers(specs.size());
  for (std::size_t input = 0; input < specs.size(); ++input) {
    if (!Cuda(cudaMalloc(&buffers[input].data, specs[input].bytes))) return 4;
  }
  VLAForgeSession* session = nullptr;
  const std::string bundle(argv[1]);
  const auto created = vlaforge_model_session_create_from_bundle(bundle.data(), bundle.size(), &session);
  if (created.code != VLAFORGE_STATUS_OK) {
    std::fprintf(stderr, "Session create failed: %u\n", static_cast<unsigned>(created.code)); return 5;
  }
  const auto* api = vlaforge_model_session_api();
  if (vlaforge_session_api_validate(api, vlaforge_generated::kSchemaDigest, VLAFORGE_SCHEMA_DIGEST_HEX_SIZE).code != VLAFORGE_STATUS_OK) {
    api->destroy(session); return 6;
  }
  int result = 0;
  for (std::size_t run = 0; run < repetitions; ++run) {
    const auto input_root = std::string(argv[2]) +
        (input_series ? "/sample-" + std::to_string(run) : "");
    VLAForgeInputStamp stamp{};
    stamp.struct_size = sizeof(stamp); stamp.has_revision = 1u; stamp.revision = run + 1u;
    for (std::size_t input = 0; input < specs.size(); ++input) {
      const auto& spec = specs[input];
      if (!Upload(input_root, input, buffers[input])) { result = 7; break; }
      const VLAForgeBoundTensor tensor{sizeof(VLAForgeBoundTensor),
          {buffers[input].data, spec.bytes, spec.shape.data(), static_cast<std::uint32_t>(spec.shape.size()), spec.dtype,
           {VLAFORGE_DEVICE_CUDA, 0}}, VLAFORGE_LAYOUT_CONTIGUOUS, 64u};
      if (api->bind_tensor(session, static_cast<std::uint32_t>(input), &tensor, &stamp).code != VLAFORGE_STATUS_OK) { result = 8; break; }
    }
    if (result || !Cuda(cudaDeviceSynchronize())) { if (!result) result = 9; break; }
    const auto start = std::chrono::steady_clock::now();
    const auto status = api->run(session);
    if (status.code != VLAFORGE_STATUS_OK || !Cuda(cudaDeviceSynchronize())) {
      std::fprintf(stderr, "Session run failed: %u\n", static_cast<unsigned>(status.code)); result = 10; break;
    }
    const auto elapsed = std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - start).count();
    VLAForgeBoundTensor output{};
    if (api->read_output_tensor(session, 0u, &output).code != VLAFORGE_STATUS_OK ||
        output.tensor.dtype != VLAFORGE_DTYPE_BF16 || output.tensor.device.kind != VLAFORGE_DEVICE_CUDA ||
        output.tensor.size_bytes != kOutputCount * sizeof(std::uint16_t)) { result = 11; break; }
    std::vector<std::uint16_t> action(kOutputCount);
    if (!Cuda(cudaMemcpy(action.data(), output.tensor.data, output.tensor.size_bytes, cudaMemcpyDeviceToHost))) { result = 12; break; }
    const auto path = std::string(argv[3]) + "/run-" + std::to_string(run) + ".bin";
    std::ofstream stream(path, std::ios::binary);
    stream.write(reinterpret_cast<const char*>(action.data()), static_cast<std::streamsize>(output.tensor.size_bytes));
    if (!stream.good()) { result = 13; break; }
    for (auto value : action) {
      const std::uint32_t bits = static_cast<std::uint32_t>(value) << 16;
      float decoded;
      std::memcpy(&decoded, &bits, sizeof(decoded));
      if (!std::isfinite(decoded)) result = 14;
    }
    std::printf("RDT,%zu,%lld\n", run, static_cast<long long>(elapsed));
    std::fflush(stdout);
    if (result) break;
  }
  std::ifstream maps("/proc/self/maps");
  std::ofstream map_output(std::string(argv[3]) + "/process-maps.txt");
  map_output << maps.rdbuf();
  api->destroy(session);
  return result;
}
