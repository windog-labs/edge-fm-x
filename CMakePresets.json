{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 18,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "host-cpu",
      "inherits": "base",
      "cacheVariables": {
        "VLAFORGE_BUILD_AOTI_BACKEND": "OFF",
        "VLAFORGE_BUILD_TORCHSCRIPT_BACKEND": "OFF"
      }
    },
    {
      "name": "host-cuda",
      "inherits": "base",
      "cacheVariables": {
        "VLAFORGE_BUILD_AOTI_BACKEND": "ON",
        "VLAFORGE_BUILD_TORCHSCRIPT_BACKEND": "OFF",
        "CMAKE_PREFIX_PATH": "$env{VLAFORGE_TORCH_CMAKE_PREFIX_PATH}"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "host-cpu",
      "configurePreset": "host-cpu"
    },
    {
      "name": "host-cuda",
      "configurePreset": "host-cuda"
    }
  ],
  "testPresets": [
    {
      "name": "host-cpu",
      "configurePreset": "host-cpu",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "host-cuda",
      "configurePreset": "host-cuda",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
